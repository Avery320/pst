{
  "name": "pst",
  "version": "0.2.0",
  "private": true,
  "description": "A lightweight timeline and table editor for presentation-ready diagrams.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none --test-reporter=spec tests/*.test.ts",
    "build": "npm run check && vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
