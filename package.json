{
  "name": "pst",
  "version": "0.2.0",
  "private": true,
  "description": "A lightweight timeline and table editor for presentation-ready diagrams.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "check": "tsc --noEmit",
    "test": "node --test --test-isolation=none --test-reporter=spec model.test.ts calendar.test.ts chart-dates.test.ts chart-interaction.test.ts",
    "build": "npm run check && vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@visactor/vtable-editors": "1.26.8",
    "@visactor/vtable-gantt": "1.26.8",
    "@visactor/vtable-plugins": "1.26.8"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
